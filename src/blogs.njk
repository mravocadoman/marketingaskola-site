---
layout: base.njk
title: "Blogs - Mārketinga Skola"
description: "Reklāmas padomi uzņēmējiem: digitālais mārketings, Facebook un Instagram reklāma, SEO, mākslīgais intelekts un citas tēmas."
permalink: "/blogs/"
---
<section class="sec sec--dark post-hero">
  <div class="container center">
    <h1>Blogs</h1>
    <p class="post-meta">Reklāmas padomi uzņēmējiem</p>
  </div>
</section>

<section class="sec">
  <div class="container">
    <p class="center" style="margin-bottom:34px">
      {% for c in categoryList %}<a class="btn btn--ghost" style="padding:8px 18px;margin:4px 6px;font-size:.85rem" href="/category/{{ c.slug }}/">{{ c.name }}</a>{% endfor %}
    </p>
    <div class="post-grid">
      {% for post in collections.posts %}
      <article class="post-card">
        <a href="{{ post.url }}">{% if post.data.image %}<img src="{{ post.data.image }}" alt="{{ post.data.title }}" loading="lazy">{% endif %}</a>
        <div class="post-card-body">
          <span class="date">{{ post.date | readableDate }}</span>
          <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
          <p>{{ post.data.description | truncate(140) }}</p>
          <a class="more" href="{{ post.url }}">Lasīt vairāk →</a>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
