{# Shared course catalog (hairline grid). Set `catalogExclude` (slug) before
   including to hide the current course.

   Only courses we actually run belong here. The placeholder entries that
   linked to the hub form ("padziļinātais Meta", "padziļinātais SEO",
   "stratēģija vadītājiem") and the TikTok course were taken out on
   4 Sep 2026 — they existed to collect interest, which is exactly the
   labour the owner wanted removed. #}
{% set catalog = [
  { slug: "meta", key: "meta-reklamas-kurss", url: "/meta-reklamas-kurss/",
    motif: "kurss-meta",
    alt: "Abstrakts sociālo tīklu plūsmas motīvs no pārklājošiem kvadrātveida laukiem",
    title: "Meta reklāmas kurss — izveido peļņu nesošas Facebook un Instagram kampaņas",
    ticks: ["Apgūsti Meta Ads pamatus un kampaņu stratēģiju", "Praktiski iestatījumi: kampaņu struktūra, testi un optimizācija", "Kā palielināt ROI un samazināt reklāmas izmaksas"],
    cta: "Uzzini vairāk" },
  { slug: "google", key: "google-ads-kurss", url: "/google-ads-kurss/",
    motif: "kurss-google",
    alt: "Abstrakts izsoles motīvs — dažāda augstuma kolonnas virs meklēšanas joslas",
    title: "Google Ads kurss — reklāma cilvēkiem, kas jau meklē Tavu produktu",
    ticks: ["Atslēgvārdu izpēte, atbilstības veidi un negatīvie atslēgvārdi", "Meklēšanas kampaņas, Performance Max un Shopping", "Konversiju uzskaite: cik maksā klients, nevis klikšķis"],
    cta: "Uzzini vairāk" },
  { slug: "seo", key: "seo-kursi", url: "/seo-kursi/",
    motif: "kurss-seo",
    alt: "Abstrakts meklētāja motīvs — aplis ar līniju un rezultātu joslām",
    title: "SEO kurss — apgūsti meklētājprogrammu pamatus",
    ticks: ["SEO pamati un praktiska optimizācija", "Kā veidot saturu, kas piesaista organisko datplūsmu", "Atslēgvārdu izpēte, tehniskais SEO un backlink stratēģija"],
    cta: "Uzzini vairāk" }
] %}
<div class="hgrid hgrid--3">
  {% for c in catalog %}{% if c.slug != catalogExclude %}{% set k = courseSessions.courses[c.key] %}
  <div class="course-tile course-tile--media">
    <figure class="cell-media cell-media--motif motif--scroll">{% include "motifs/" + c.motif + ".njk" %}</figure>
    <div class="course-tag">Tiešsaistē · Iesācējiem · {{ k.hours }} stundas</div>
    <h3><a href="{{ c.url }}">{{ c.title }}</a></h3>
    <ul class="tick-list">
      {% for t in c.ticks %}<li>{{ t }}</li>{% endfor %}
    </ul>
    <ul class="course-facts" style="margin:0 0 20px">
      <li><span>Cena</span><span>{{ k.price }} € + PVN</span></li>
      <li><span>Pasniedzējs</span><span>{{ k.instructor }}</span></li>
      <li><span>Norise</span><span>{{ k.cadence | capitalize }}</span></li>
    </ul>
    <a class="arrow-link" href="{{ c.url }}">{{ c.cta }}</a>
  </div>
  {% endif %}{% endfor %}
  {% if catalogExclude %}
  <div class="course-tile course-tile--media">
    <figure class="cell-media cell-media--motif motif--scroll">{% include "motifs/kurss-hub.njk" %}</figure>
    <div class="course-tag">Katalogs</div>
    <h3><a href="/digitala-marketinga-kursi/">Visi kursi un apmācības vienuviet</a></h3>
    <ul class="tick-list">
      <li>Tiešsaistes kursi ar pasniedzēju — Meta reklāma, Google Ads un SEO</li>
      <li>Grupu apmācības un atsevišķi piedāvājumi komandām</li>
    </ul>
    <a class="arrow-link" href="/digitala-marketinga-kursi/">Apskatīt katalogu</a>
  </div>
  {% endif %}
</div>
