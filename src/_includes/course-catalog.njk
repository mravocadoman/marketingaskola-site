{# Shared course catalog. Set `catalogExclude` (slug) before including to hide
   the current course. Courses without their own page link to the hub form. #}
{% set catalog = [
  { slug: "meta", url: "/meta-reklamas-kurss/", tag: "Iesācējiem · 3 stundas",
    title: "Meta reklāmas kurss — izveido peļņu nesošas Facebook un Instagram kampaņas",
    ticks: ["Apgūsti Meta Ads pamatus un padziļinātu stratēģiju", "Praktiski iestatījumi: kampaņu struktūra, testi un optimizācija", "Kā palielināt ROI un samazināt reklāmas izmaksas"],
    cta: "Uzzini vairāk" },
  { slug: "meta-pro", url: "/digitala-marketinga-kursi/#piesakies", tag: "Speciālistiem · 4 stundas",
    title: "Padziļināts Facebook un Instagram reklāmas kurss",
    ticks: ["Padziļināta izpratne par Meta Ads stratēģisko pielietojumu", "Uzlabota mērķauditorijas atlase: remārketings un lookalike auditorijas", "Facebook Pixel un Conversion API (CAPI) iestatīšana"],
    cta: "Pieteikties interesei" },
  { slug: "tiktok", url: "/tiktok-kursi/", tag: "Iesācējiem · 4 stundas",
    title: "TikTok reklāmas kurss — sasniedz jaunu auditoriju",
    ticks: ["TikTok Ads platformas iespējas un labākās prakses", "Kā izveidot augstas veiktspējas reklāmas un palielināt iesaisti", "Budžeta un mērķauditorijas optimizācija"],
    cta: "Uzzini vairāk" },
  { slug: "seo", url: "/seo-kursi/", tag: "Iesācējiem · 4 stundas",
    title: "SEO kurss — apgūsti meklētājprogrammu pamatus",
    ticks: ["SEO pamati un padziļināta optimizācija", "Kā veidot saturu, kas piesaista organisko datplūsmu", "Atslēgvārdu izpēte, tehniskais SEO un backlink stratēģija"],
    cta: "Uzzini vairāk" },
  { slug: "seo-pro", url: "/digitala-marketinga-kursi/#piesakies", tag: "Speciālistiem · 4 stundas",
    title: "Padziļināts SEO kurss — kā nokļūt Google pirmajā lapā",
    ticks: ["Kā sasniegt augstākās pozīcijas Google", "Padziļinātas SEO metodes praksē", "Kā uzraudzīt SEO speciālistus un aģentūras"],
    cta: "Pieteikties interesei" },
  { slug: "strategija", url: "/digitala-marketinga-kursi/#piesakies", tag: "Vadītājiem · 4 stundas",
    title: "Digitālā mārketinga stratēģijas kurss vadītājiem",
    ticks: ["Kā plānot efektīvu digitālā mārketinga stratēģiju", "Mērķauditorijas un konkurentu analīze", "Budžeta plānošana un mārketinga ROI aprēķins"],
    cta: "Pieteikties interesei" }
] %}
<div class="row cols-3 top">
  {% for c in catalog %}{% if c.slug != catalogExclude %}
  <div class="col">
    <div class="course-tile">
      <div class="course-tag">{{ c.tag }}</div>
      <h3><a href="{{ c.url }}">{{ c.title }}</a></h3>
      <ul class="tick-list">
        {% for t in c.ticks %}<li>{{ t }}</li>{% endfor %}
      </ul>
      <a class="arrow-link" href="{{ c.url }}">{{ c.cta }}</a>
    </div>
  </div>
  {% endif %}{% endfor %}
</div>
