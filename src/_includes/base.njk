<!doctype html>
<html lang="lv">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = seoTitle or title or site.tagline %}
  {%- set pageImage = (image or site.image) | ogImage %}
  {%- set pageUrl = site.url + page.url %}
  {%- set isArticle = layout == 'post.njk' %}
  {%- set analytics = site.analytics.gtmId and not env.preview %}
  <title>{{ pageTitle }}</title>
  {% if env.preview or noindex %}<meta name="robots" content="noindex">{% endif %}
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  {% if not noindex %}<link rel="canonical" href="{{ pageUrl }}">{% endif %}
  <meta name="theme-color" content="#020d1c">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="lv_LV">
  <meta property="og:type" content="{% if isArticle %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ pageTitle }}">
  {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:image" content="{{ site.url }}{{ pageImage }}">
  {% if isArticle %}<meta property="article:published_time" content="{{ date | isoDate }}">
  <meta property="article:modified_time" content="{{ (updated or date) | isoDate }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  {% if description %}<meta name="twitter:description" content="{{ description }}">{% endif %}
  <meta name="twitter:image" content="{{ site.url }}{{ pageImage }}">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/img/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="icon" href="/img/favicon-192.png" type="image/png" sizes="192x192">
  <link rel="apple-touch-icon" href="/img/favicon-192.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }} — blogs" href="/feed.xml">
  <link rel="preload" href="/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/space-grotesk-var-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/style.css">
  {%- set sd = { site: site, url: page.url, title: pageTitle, description: description, image: pageImage, layout: layout, date: date, updated: updated, categories: categories, cat: cat, crumb: crumb, course: course, heroTitle: heroTitle, categoriesBySlug: categoriesBySlug } %}
  <script type="application/ld+json">{{ sd | schemaGraph | jsonld | safe }}</script>
</head>
<body>
<a class="skip-link" href="#saturs-sakums">Pāriet uz saturu</a>

<div class="topbar">
  <div class="container topbar-inner">
    <div class="topbar-contacts">
      <a href="https://wa.me/37126673384" target="_blank" rel="noopener" aria-label="WhatsApp">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a9.9 9.9 0 0 0-8.5 15L2 22l5.1-1.4A10 10 0 1 0 12 2zm5.8 14.2c-.25.7-1.45 1.35-2 1.4-.55.08-1.05.35-3.55-.74-3-1.32-4.9-4.4-5.05-4.6-.15-.2-1.2-1.6-1.2-3.05 0-1.45.76-2.16 1.03-2.46.27-.3.59-.37.79-.37h.57c.18 0 .43-.07.67.5l.92 2.22c.08.17.13.36.02.56l-.37.56-.53.57c-.16.16-.34.34-.15.67.2.33.87 1.44 1.87 2.33 1.29 1.15 2.37 1.5 2.71 1.67.34.17.53.14.73-.08l1.1-1.28c.25-.33.47-.25.79-.15l2.02.95c.33.17.55.25.63.39.08.13.08.78-.17 1.48z"/></svg>
        {{ site.phone }}
      </a>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
    </div>
    <div class="topbar-social">
      <a href="{{ site.facebook }}" aria-label="Facebook" target="_blank" rel="noopener"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12z"/></svg></a>
      <a href="{{ site.instagram }}" aria-label="Instagram" target="_blank" rel="noopener"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.9.9 1.4.2.4.4 1.1.4 2.2.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2a3.9 3.9 0 0 1-.9 1.4 3.9 3.9 0 0 1-1.4.9c-.4.2-1.1.4-2.2.4-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4a3.9 3.9 0 0 1-1.4-.9 3.9 3.9 0 0 1-.9-1.4c-.2-.4-.4-1.1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.9-.7 1.4-.9.4-.2 1.1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 3.1a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 1.8a3.2 3.2 0 1 0 0 6.4 3.2 3.2 0 0 0 0-6.4zm5.2-3.2a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4z"/></svg></a>
      <a href="{{ site.linkedin }}" aria-label="LinkedIn" target="_blank" rel="noopener"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.4 20.4h-3.5v-5.6c0-1.3 0-3-1.9-3-1.9 0-2.1 1.4-2.1 2.9v5.7H9.4V9h3.4v1.6h.1c.5-.9 1.6-1.9 3.4-1.9 3.6 0 4.2 2.4 4.2 5.4v6.3zM5.3 7.4a2 2 0 1 1 0-4.1 2 2 0 0 1 0 4.1zm1.8 13H3.6V9h3.5v11.4zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7c0-.9-.8-1.7-1.8-1.7z"/></svg></a>
    </div>
  </div>
</div>

<header class="header">
  <div class="container header-inner">
    <a class="brand" href="/"><img src="/img/logo.webp" alt="{{ site.name }}" width="190" height="75"></a>
    <button class="nav-toggle" aria-label="Izvēlne" aria-expanded="false" aria-controls="main-nav"><span></span><span></span><span></span></button>
    <nav class="nav" id="main-nav" aria-label="Galvenā izvēlne">
      <ul>
        {% for item in site.nav %}
        <li class="{% if item.children %}has-children{% endif %}{% if item.cta %} nav-cta{% endif %}{% if page.url == item.url %} active{% endif %}">
          <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
          {% if item.children %}
          <ul class="dropdown">
            {% for child in item.children %}
            <li><a href="{{ child.url }}"{% if page.url == child.url %} aria-current="page"{% endif %}>{{ child.label }}</a></li>
            {% endfor %}
          </ul>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>

<main id="saturs-sakums">
{{ content | safe }}
</main>

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="wordmark">Mārketinga Skola</span>
        <p>Digitālā mārketinga aģentūra un praktiski kursi. Palīdzam Latvijas uzņēmumiem paredzami piesaistīt jaunus klientus.</p>
        <div class="footer-social">
          <a href="{{ site.facebook }}" aria-label="Facebook" target="_blank" rel="noopener"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12z"/></svg></a>
          <a href="{{ site.instagram }}" aria-label="Instagram" target="_blank" rel="noopener"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.9.9 1.4.2.4.4 1.1.4 2.2.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2a3.9 3.9 0 0 1-.9 1.4 3.9 3.9 0 0 1-1.4.9c-.4.2-1.1.4-2.2.4-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4a3.9 3.9 0 0 1-1.4-.9 3.9 3.9 0 0 1-.9-1.4c-.2-.4-.4-1.1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.9-.7 1.4-.9.4-.2 1.1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 3.1a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 1.8a3.2 3.2 0 1 0 0 6.4 3.2 3.2 0 0 0 0-6.4zm5.2-3.2a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4z"/></svg></a>
          <a href="{{ site.linkedin }}" aria-label="LinkedIn" target="_blank" rel="noopener"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.4 20.4h-3.5v-5.6c0-1.3 0-3-1.9-3-1.9 0-2.1 1.4-2.1 2.9v5.7H9.4V9h3.4v1.6h.1c.5-.9 1.6-1.9 3.4-1.9 3.6 0 4.2 2.4 4.2 5.4v6.3zM5.3 7.4a2 2 0 1 1 0-4.1 2 2 0 0 1 0 4.1zm1.8 13H3.6V9h3.5v11.4zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7c0-.9-.8-1.7-1.8-1.7z"/></svg></a>
        </div>
      </div>
      <div>
        <p class="footer-h">Pakalpojumi</p>
        <ul>
          <li><a href="/facebook-reklama/">Facebook reklāma</a></li>
          <li><a href="/video-reklama/">Video reklāma</a></li>
          <li><a href="/socialo-mediju-marketings/">Sociālo mediju mārketings</a></li>
          <li><a href="/ai-un-automatizacijas/">AI un automatizācijas</a></li>
          <li><a href="/marketinga-konsultacijas/">Mārketinga konsultācijas</a></li>
          <li><a href="/portfolio/">Portfolio</a></li>
        </ul>
      </div>
      <div>
        <p class="footer-h">Kursi</p>
        <ul>
          <li><a href="/digitala-marketinga-kursi/">Digitālā mārketinga kursi</a></li>
          <li><a href="/meta-reklamas-kurss/">Meta reklāmas kurss</a></li>
          <li><a href="/seo-kursi/">SEO kursi</a></li>
          <li><a href="/tiktok-kursi/">TikTok kursi</a></li>
        </ul>
      </div>
      <div>
        <p class="footer-h">Kontakti</p>
        <ul>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li><a href="https://wa.me/37126673384" target="_blank" rel="noopener">{{ site.phone }} (WhatsApp)</a></li>
          <li>{{ site.company.address }}</li>
          <li><a href="/blogs/">Blogs</a> · <a href="/feed.xml">RSS</a></li>
          <li><a href="/privatuma-politika/">Privātuma politika</a>{% if analytics %} · <button type="button" class="linkish" data-consent-open>Sīkdatņu iestatījumi</button>{% endif %}</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {{ site.name }} {% year %}</span>
      <span>{{ site.company.name }} · Reģ. nr. {{ site.company.regNr }} · PVN {{ site.company.vat }}</span>
    </div>
  </div>
</footer>

{% if analytics %}
<div class="consent" data-consent hidden role="region" aria-label="Sīkdatņu paziņojums">
  <p><strong>Sīkdatnes.</strong> Ar Tavu piekrišanu izmantojam analītikas un reklāmas sīkdatnes, lai saprastu, kā vietne tiek lietota, un mērītu reklāmas efektivitāti. Bez piekrišanas tās netiek iestatītas. <a href="/privatuma-politika/">Privātuma politika</a></p>
  <div class="consent-actions">
    <button class="btn btn--ghost btn--sm" type="button" data-consent-accept>Piekrītu</button>
    <button class="btn btn--ghost btn--sm" type="button" data-consent-reject>Noraidīt</button>
  </div>
</div>
<script src="/js/consent.js" defer data-gtm="{{ site.analytics.gtmId }}"></script>
{% endif %}

{%- set waText = "Sveiki! Rakstu no marketingaskola.lv lapas “" + ((heroTitle or title or site.name) | bareTitle) + "” (" + pageUrl + "). " %}
<a class="wa-float" href="https://wa.me/37126673384?text={{ waText | urlencode }}" target="_blank" rel="noopener" data-track="whatsapp-float" aria-label="Rakstīt mums WhatsApp">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a9.9 9.9 0 0 0-8.5 15L2 22l5.1-1.4A10 10 0 1 0 12 2zm5.8 14.2c-.25.7-1.45 1.35-2 1.4-.55.08-1.05.35-3.55-.74-3-1.32-4.9-4.4-5.05-4.6-.15-.2-1.2-1.6-1.2-3.05 0-1.45.76-2.16 1.03-2.46.27-.3.59-.37.79-.37h.57c.18 0 .43-.07.67.5l.92 2.22c.08.17.13.36.02.56l-.37.56-.53.57c-.16.16-.34.34-.15.67.2.33.87 1.44 1.87 2.33 1.29 1.15 2.37 1.5 2.71 1.67.34.17.53.14.73-.08l1.1-1.28c.25-.33.47-.25.79-.15l2.02.95c.33.17.55.25.63.39.08.13.08.78-.17 1.48z"/></svg>
  <span class="wa-float-label">WhatsApp</span>
</a>

<script src="/js/main.js" defer></script>
<script src="/js/forms.js" defer></script>
</body>
</html>
