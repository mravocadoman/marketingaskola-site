{# Rebuilt 9 Sep 2026: ONE solid icon per item, in the same filled style as the
   hero motifs. The first version used thin outlined diagrams, which the owner
   rejected as not matching the headers and too dim. Text is page markup, never
   drawn into the picture. #}
<figure class="figcols">
  <h3 class="figcols-h">Trīs kursi, trīs kanāli<span class="accent-text">.</span></h3>
  <div class="figcols-grid">
    <div class="figcol">
      <span class="figcol-idx">01</span>
      <svg class="motif figcol-icon" viewBox="0 0 96 96" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><g class="m" style="--i:0"><rect x="20" y="4" width="56" height="88" fill="#8ba3bd"/></g><g class="m" style="--i:1"><rect x="26" y="12" width="44" height="34" fill="#f2f5f8"/></g><g class="m" style="--i:2"><rect x="26" y="54" width="44" height="5" fill="#f2f5f8"/></g><g class="m" style="--i:3"><rect x="26" y="64" width="32" height="5" fill="#f2f5f8"/></g><g class="m" style="--i:4"><rect x="26" y="76" width="22" height="8" fill="#03c3f8"/></g></svg>
      <h4>{{ courseSessions.courses["meta-reklamas-kurss"].name }}</h4>
      <p>Radi pieprasījumu tur, kur cilvēks Tevi vēl nemeklē</p>
      <p class="figcol-foot">{{ courseSessions.courses["meta-reklamas-kurss"].hours }} stundas</p>
    </div>
    <div class="figcol">
      <span class="figcol-idx">02</span>
      <svg class="motif figcol-icon" viewBox="0 0 96 96" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><g class="m" style="--i:0"><rect x="4" y="64" width="88" height="16" fill="#f2f5f8"/></g><g class="m" style="--i:1"><rect x="8" y="68" width="4" height="8" fill="#03c3f8"/></g><g class="m" style="--i:2"><rect x="16" y="40" width="14" height="20" fill="#8ba3bd"/></g><g class="m" style="--i:3"><rect x="38" y="24" width="14" height="36" fill="#8ba3bd"/></g><g class="m" style="--i:4"><rect x="60" y="34" width="14" height="26" fill="#8ba3bd"/></g><g class="m" style="--i:5"><rect x="78" y="46" width="10" height="14" fill="#8ba3bd"/></g></svg>
      <h4>{{ courseSessions.courses["google-ads-kurss"].name }}</h4>
      <p>Esi klāt brīdī, kad cilvēks jau meklē Tavu produktu</p>
      <p class="figcol-foot">{{ courseSessions.courses["google-ads-kurss"].hours }} stundas</p>
    </div>
    <div class="figcol">
      <span class="figcol-idx">03</span>
      <svg class="motif figcol-icon" viewBox="0 0 96 96" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><g class="m" style="--i:0"><rect x="10" y="8" width="76" height="14" fill="#03c3f8"/></g><g class="m" style="--i:1"><rect x="10" y="30" width="62" height="12" fill="#8ba3bd"/></g><g class="m" style="--i:2"><rect x="10" y="50" width="50" height="12" fill="#8ba3bd"/></g><g class="m" style="--i:3"><rect x="10" y="70" width="38" height="12" fill="#8ba3bd"/></g></svg>
      <h4>SEO</h4>
      <p>Nopelni vietu meklētājā bez maksas par klikšķi</p>
      <p class="figcol-foot">{{ courseSessions.courses["seo-kursi"].hours }} stundas</p>
    </div>
