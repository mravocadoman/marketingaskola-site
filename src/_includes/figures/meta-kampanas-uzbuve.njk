{# Meta kampaņas uzbūve. Three frames of identical size on a shared baseline,
   nothing connecting them - the cross-column hierarchy version was rejected
   on 5 Sep for leaving column 01 half empty. #}
<figure class="figcols">
  <h3 class="figcols-h">Meta kampaņas uzbūve<span class="accent-text">.</span></h3>
  <div class="figcols-grid">
    <div class="figcol">
      <span class="figcol-idx">01</span>
      <h4>Kampaņa</h4>
      <p>Mērķis: pārdošana, pieteikumi vai atpazīstamība</p>
      <svg class="motif figcol-art" viewBox="0 0 320 300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <g class="m" style="--i:0"><rect x="40" y="40" width="240" height="220" fill="none" stroke="#8ba3bd" stroke-width="2"/></g>
        <g class="m" style="--i:1"><rect x="76" y="86" width="168" height="34" fill="none" stroke="#f2f5f8" stroke-width="2"/></g>
        <g class="m" style="--i:2"><rect x="76" y="140" width="168" height="34" fill="none" stroke="#8ba3bd" stroke-width="2"/></g>
        <g class="m" style="--i:3"><rect x="76" y="194" width="168" height="34" fill="none" stroke="#8ba3bd" stroke-width="2"/></g>
        <g class="m" style="--i:4"><rect x="88" y="96" width="14" height="14" fill="#03c3f8"/></g>
      </svg>
      <p class="figcol-foot">Viens mērķis, ne trīs</p>
    </div>
    <div class="figcol">
      <span class="figcol-idx">02</span>
      <h4>Reklāmu kopa</h4>
      <p>Auditorija, budžets un izvietojumi</p>
      <svg class="motif figcol-art" viewBox="0 0 320 300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <g class="m" style="--i:0"><rect x="40" y="40" width="240" height="220" fill="none" stroke="#8ba3bd" stroke-width="2"/></g>
        <g class="m" style="--i:1"><circle cx="160" cy="130" r="56" fill="none" stroke="#f2f5f8" stroke-width="2"/></g>
        <g class="m" style="--i:2"><circle cx="160" cy="130" r="26" fill="none" stroke="#03c3f8" stroke-width="2"/></g>
        <g class="m" style="--i:3"><path d="M76 214 h168" stroke="#8ba3bd" stroke-width="2"/><path d="M76 214 h84" stroke="#03c3f8" stroke-width="4"/></g>
        <g class="m" style="--i:4"><rect x="70" y="206" width="16" height="16" fill="#020d1c" stroke="#8ba3bd" stroke-width="2"/><rect x="234" y="206" width="16" height="16" fill="#020d1c" stroke="#8ba3bd" stroke-width="2"/></g>
      </svg>
      <p class="figcol-foot">Šeit dzīvo budžets</p>
    </div>
    <div class="figcol">
      <span class="figcol-idx">03</span>
      <h4>Reklāma</h4>
      <p>Teksts, vizuālis un aicinājums rīkoties</p>
      <svg class="motif figcol-art" viewBox="0 0 320 300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <g class="m" style="--i:0"><rect x="40" y="40" width="240" height="220" fill="none" stroke="#8ba3bd" stroke-width="2"/></g>
        <g class="m" style="--i:1"><rect x="70" y="70" width="180" height="104" fill="none" stroke="#f2f5f8" stroke-width="2"/></g>
        <g class="m" style="--i:2"><path d="M70 196 h180 M70 216 h140" stroke="#8ba3bd" stroke-width="2"/></g>
        <g class="m" style="--i:3"><rect x="70" y="234" width="88" height="20" fill="none" stroke="#03c3f8" stroke-width="2"/></g>
      </svg>
      <p class="figcol-foot">Trīs līdz pieci varianti</p>
    </div>
  </div>
</figure>
