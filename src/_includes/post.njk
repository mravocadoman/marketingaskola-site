---
layout: base.njk
---
<section class="page-hero page-hero--pull">
  <div class="container container--narrow">
    <span class="chip">
      {% if categories.length %}{% for c in categories %}<a href="/category/{{ c }}/">{{ categoriesBySlug[c] or c }}</a>{% if not loop.last %} · {% endif %}{% endfor %}{% else %}Blogs{% endif %}
    </span>
    <h1>{{ title }}</h1>
    <p class="sub"><time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>{% if updated and (updated != (date | isoDate)) %} · atjaunots {{ updated | readableDate }}{% endif %}</p>
  </div>
</section>

<article class="sec" style="padding-top:0">
  <div class="container container--narrow article-pull">
    {% if image %}<img class="post-featured" src="{{ image }}" alt="{{ title }}">{% endif %}
    <div class="prose">
      {{ content | safe }}
    </div>

    <div class="cta" style="margin-top:56px">
      <h3>Vēlies, lai Tavu mārketingu vada praktiķi?</h3>
      <p>Piesakies konsultācijai — izrunāsim Tavu situāciju un ieteiksim konkrētus nākamos soļus.</p>
      <div class="btn-wrap">
        <a class="btn" href="/sazinies/">Pieteikties konsultācijai</a>
        <a class="btn btn--ghost" href="/digitala-marketinga-kursi/">Apskatīt kursus</a>
      </div>
    </div>
  </div>
</article>

{% set related = collections.posts | relatedPosts(categories, page.fileSlug, 3) %}
{% if related.length %}
<section class="sec sec--soft">
  <div class="container">
    <div class="row cols-1">
      <div class="col center">
        <span class="eyebrow">Turpini lasīt</span>
        <h2>Saistītie raksti</h2>
      </div>
    </div>
    <div class="post-grid">
      {% for post in related %}
      <article class="post-card">
        <a href="{{ post.url }}">{% if post.data.image %}<img src="{{ post.data.image }}" alt="{{ post.data.title }}" loading="lazy">{% endif %}</a>
        <div class="post-card-body">
          <span class="date">{{ post.date | readableDate }}</span>
          <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
          <p>{{ post.data.description | truncate(120) }}</p>
          <a class="more" href="{{ post.url }}">Lasīt vairāk →</a>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
