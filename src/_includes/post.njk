---
layout: base.njk
---
{% set body = content | withAnchors %}
{% set outline = body | toc %}

<div class="read-progress" data-read-progress aria-hidden="true"></div>

<section class="page-hero{% if image %} page-hero--cover{% endif %}">
  {% if image %}
  <figure class="hero-bg" aria-hidden="true">
    <img src="{{ image | webp }}" alt="">
  </figure>
  {% endif %}
  <div class="container container--narrow">
    <span class="chip">
      {% if categories.length %}{% for c in categories %}<a href="/category/{{ c }}/">{{ categoriesBySlug[c] or c }}</a>{% if not loop.last %} · {% endif %}{% endfor %}{% else %}Blogs{% endif %}
    </span>
    <h1>{{ title }}</h1>
    <p class="article-meta">
      <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
      <span class="dot"></span>
      <span>{{ content | readingTime }} min lasīšana</span>
      {% if updated and (updated != (date | isoDate)) %}<span class="dot"></span><span>atjaunots {{ updated | readableDate }}</span>{% endif %}
    </p>
  </div>
</section>

<div class="paper">
  <div class="container article-shell">
    <div class="article-grid">
      <article class="article-body">
        <div class="prose">
          {{ body | safe }}
        </div>

        <div class="author-strip">
          <img src="/img/gen/team-rihards.webp" alt="Rihards Zeiļa" loading="lazy">
          <div>
            <strong>Mārketinga Skola</strong>
            <span>Praktisks digitālais mārketings — Meta un Google reklāmas, video saturs un kursi.</span>
          </div>
        </div>
      </article>

      {% if outline.length > 2 %}
      <aside class="toc" aria-label="Satura rādītājs">
        <h4>Satura rādītājs</h4>
        <ol data-toc>
          {% for h in outline %}
          <li><a href="#{{ h.id }}">{{ h.text }}</a></li>
          {% endfor %}
        </ol>
      </aside>
      {% endif %}
    </div>
  </div>
</div>

<section class="cta-band">
  <div class="container cta-band-inner">
    <div>
      <h2>Vēlies, lai Tavu mārketingu vada praktiķi?</h2>
      <p>Piesakies konsultācijai — izrunāsim Tavu situāciju un ieteiksim konkrētus nākamos soļus.</p>
    </div>
    <div class="btn-wrap">
      <a class="btn" href="/sazinies/">Pieteikties konsultācijai</a>
      <a class="btn btn--ghost" href="/digitala-marketinga-kursi/">Apskatīt kursus</a>
    </div>
  </div>
</section>

{% set related = collections.posts | relatedPosts(categories, page.fileSlug, 3) %}
{% if related.length %}
<section class="sec">
  <div class="container">
    <div class="sec-head">
      <div>
        <span class="eyebrow"><span class="idx">01</span> Turpini lasīt</span>
        <h2>Saistītie raksti</h2>
      </div>
      <p class="lead"><a class="arrow-link" href="/blogs/">Viss blogs</a></p>
    </div>
    <div class="post-grid">
      {% for post in related %}
      <article class="post-card">
        <a href="{{ post.url }}">{% if post.data.image %}<img src="{{ post.data.image | webp }}" alt="{{ post.data.title }}" loading="lazy">{% endif %}</a>
        <div class="post-card-body">
          <span class="date">{{ post.date | readableDate }}</span>
          <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
          <p>{{ post.data.description | truncate(120) }}</p>
          <span class="more">Lasīt vairāk</span>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
