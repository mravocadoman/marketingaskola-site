{# Scheduled groups for one live course. Set `courseKey` (matching a key in
   src/_data/courseSessions.json) and `courseName` (the label the fallback
   form preselects) before including:

     {% set courseKey = "meta-reklamas-kurss" %}
     {% set courseName = "Meta reklāmas kurss" %}
     {% include "course-sessions.njk" %}

   One Stripe payment link (`bookUrl`) covers every date, because its
   after-payment redirect drops the buyer on the Cal.com event where the
   months are the real availability and the seat count is enforced. So the
   dates here are information and there is ONE call to action, rather than a
   button per date that could not preselect anything anyway.

   The DATES show as soon as they exist, with or without a payment link -
   they are information a buyer needs either way. Only the call to action
   switches: the Stripe button once `bookUrl` is set, the application form
   until then. Import with context. #}
{% from "form.njk" import form with context %}
{% set cs = courseSessions.courses[courseKey] %}
{% if cs.sessions.length %}
<div class="hgrid hgrid--4">
  {% for s in cs.sessions %}
  <div class="cell" data-date="{{ s.date }}">
    <span class="cell-idx">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
    <h3>{{ s.label }}</h3>
    <ul class="course-facts">
      <li><span>Laiks</span><span>{{ cs.time }}</span></li>
      <li><span>Norise</span><span>{{ cs.format }}</span></li>
    </ul>
  </div>
  {% endfor %}
</div>
{% if cs.bookUrl %}
{% set invoiceSubject = "Rēķins: " ~ cs.name %}
{% set invoiceBody = "Kurss: " ~ cs.name ~ "\nDatums: \nUzņēmums: \nReģ. nr.: \nE-pasts rēķinam: \nDalībnieku skaits: " %}
<div class="btn-wrap" style="margin-top:clamp(28px,3vw,40px)">
  <a class="btn" href="{{ cs.bookUrl }}">Rezervēt vietu — {{ cs.price }} € + PVN</a>
  {% if cs.calendarUrl %}<a class="btn btn--ghost" href="{{ cs.calendarUrl }}" target="_blank" rel="noopener">Apskatīt kalendāru</a>{% endif %}
</div>
<p class="fine">{{ cs.price }} € + PVN {{ courseSessions.policy.vatRate }}% — kopā {{ cs.price | gross(courseSessions.policy.vatRate) }} €. Pēc apmaksas izvēlies sev piemēroto datumu kalendārā — grupā līdz {{ courseSessions.policy.maxSeats }} dalībniekiem.</p>
<p class="fine" style="margin-top:10px">Bezmaksas atteikšanās līdz {{ courseSessions.policy.refundDaysBefore }} dienām pirms norises. Ja grupa nesanāk — pilna atmaksa, pārcelšana vai konsultācija, izvēle ir Tava.</p>
{% if cs.proof %}<p class="fine" style="margin-top:10px">{{ cs.proof }}</p>{% endif %}
<div class="fine-more">
  <details class="faq"><summary>Grupas nosacījumi, atteikšanās un rēķins</summary><div>
    <p>Grupa notiek no {{ courseSessions.policy.minSeats }} dalībniekiem. Ja tik daudz nesanāk, {{ courseSessions.policy.decideDaysBefore }} dienas pirms norises pārceļam uz nākamo mēnesi, atgriežam samaksu vai pārvēršam to individuālā konsultācijā — izvēle ir Tava.</p>
    <p>Ja piesakies vēlāk nekā {{ courseSessions.policy.refundDaysBefore }} dienas pirms norises, pilna atmaksa pienākas {{ courseSessions.policy.lateBookingGraceHours }} stundu laikā pēc pieteikšanās.</p>
    <p>Uzņēmumiem izrakstām rēķinu ar bankas pārskaitījumu: <a href="mailto:{{ site.email }}?subject={{ invoiceSubject | urlencode }}&amp;body={{ invoiceBody | urlencode }}">pieprasīt rēķinu</a> — norādi kursu, datumu, uzņēmumu, reģistrācijas numuru un dalībnieku skaitu. Pēc rēķina apmaksas nosūtām kalendāra saiti.</p>
  </div></details>
</div>
{% else %}
<div style="max-width:820px;margin-top:clamp(28px,3vw,40px)">
  <p class="fine" style="margin-top:0">Vietu skaits grupā ir ierobežots ({{ courseSessions.policy.maxSeats }} dalībnieki), un grupa notiek no {{ courseSessions.policy.minSeats }} dalībniekiem. Piesakies zemāk — apstiprināsim vietu un atsūtīsim apmaksas informāciju.</p>
  {{ form("course", { course: courseName }) }}
</div>
{% endif %}
{% else %}
<div style="max-width:820px">{{ form("course", { course: courseName }) }}</div>
{% endif %}
