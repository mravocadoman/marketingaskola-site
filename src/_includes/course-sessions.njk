{# Scheduled groups for one live course. Set `courseKey` (matching a key in
   src/_data/courseSessions.json) and `courseName` (the label the form
   preselects) before including:

     {% set courseKey = "seo-kursi" %}
     {% set courseName = "SEO kurss" %}
     {% include "course-sessions.njk" %}

   With dates in the data file it renders them as bookable cards, each with
   its own Stripe payment link. With an empty list it falls back to the
   application form, so the page is valid either way and adding a month is a
   data edit rather than a template change. #}
{% from "form.njk" import form with context %}
{% set cs = courseSessions.courses[courseKey] %}
{% if cs.sessions.length %}
<div class="hgrid hgrid--3">
  {% for s in cs.sessions %}
  <div class="cell">
    <span class="cell-idx">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
    <h3>{{ s.label }}</h3>
    <ul class="course-facts">
      <li><span>Laiks</span><span>{{ s.time }}</span></li>
      <li><span>Norise</span><span>{{ s.format }}</span></li>
      {% if s.seats %}<li><span>Vietas</span><span>{{ s.seats }}</span></li>{% endif %}
    </ul>
    <a class="btn btn--ghost btn--sm" href="{{ s.url }}">Rezervēt vietu</a>
  </div>
  {% endfor %}
</div>
<p class="fine">Vietu rezervē apmaksa. Bezmaksas atteikšanās ar pilnu naudas atmaksu līdz {{ courseSessions.policy.refundDaysBefore }} dienām pirms norises; vēlāk vietu varam pārcelt uz nākamo grupu. Uzņēmumiem izrakstām rēķinu ar bankas pārskaitījumu — raksti uz <a href="mailto:{{ site.email }}">{{ site.email }}</a>.</p>
{% else %}
<div style="max-width:820px">{{ form("course", { course: courseName }) }}</div>
{% endif %}
