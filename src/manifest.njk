---
permalink: "/site.webmanifest"
eleventyExcludeFromCollections: true
---
{
  "name": "{{ site.name }}",
  "short_name": "{{ site.name }}",
  "lang": "lv",
  "start_url": "{{ '/' | url }}",
  "display": "browser",
  "background_color": "#020d1c",
  "theme_color": "#020d1c",
  "icons": [
    { "src": "{{ '/img/favicon-192.png' | url }}", "sizes": "192x192", "type": "image/png" }
  ]
}
