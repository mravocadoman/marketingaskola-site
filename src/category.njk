---
layout: base.njk
pagination:
  data: categoryList
  size: 1
  alias: cat
permalink: "/category/{{ cat.slug }}/"
eleventyComputed:
  title: "{{ cat.name }} Raksti - Mārketinga Skola"
  description: "Bloga raksti kategorijā {{ cat.name }}."
---
<section class="sec sec--dark post-hero">
  <div class="container center">
    <h1>{{ cat.name }} Raksti</h1>
    <p class="post-meta"><a href="/blogs/">← Viss blogs</a></p>
  </div>
</section>

<section class="sec">
  <div class="container">
    <div class="post-grid">
      {% for post in collections.posts | inCategory(cat.posts) %}
      <article class="post-card">
        <a href="{{ post.url }}">{% if post.data.image %}<img src="{{ post.data.image }}" alt="{{ post.data.title }}" loading="lazy">{% endif %}</a>
        <div class="post-card-body">
          <span class="date">{{ post.date | readableDate }}</span>
          <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
          <p>{{ post.data.description | truncate(140) }}</p>
          <a class="more" href="{{ post.url }}">Lasīt vairāk →</a>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
